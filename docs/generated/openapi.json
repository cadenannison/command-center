{
  "components": {
    "schemas": {
      "ConnectRequest": {
        "additionalProperties": false,
        "description": "Credentials for one source. Write-only: no response model has a field for them.",
        "properties": {
          "credentials": {
            "maxProperties": 32,
            "minProperties": 1,
            "patternProperties": {
              "^[A-Za-z0-9_.-]{1,64}$": {
                "maxLength": 8192,
                "minLength": 1,
                "type": "string"
              }
            },
            "title": "Credentials",
            "type": "object"
          }
        },
        "required": [
          "credentials"
        ],
        "title": "ConnectRequest",
        "type": "object"
      },
      "ConnectResult": {
        "description": "Outcome of connecting a source.\n\nWhen `ok` is false nothing was stored, except if the secret store failed part-way through\nwriting the keys: then the keys written before the failure stay stored.",
        "properties": {
          "message": {
            "title": "Message",
            "type": "string"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          },
          "source": {
            "title": "Source",
            "type": "string"
          },
          "sync": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SyncState"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "source",
          "ok",
          "message"
        ],
        "title": "ConnectResult",
        "type": "object"
      },
      "DailySummary": {
        "additionalProperties": false,
        "description": "A day's briefing. Plain str / list[str] fields: also the provider's output schema.",
        "properties": {
          "headline": {
            "maxLength": 300,
            "title": "Headline",
            "type": "string"
          },
          "heads_up": {
            "items": {
              "maxLength": 300,
              "type": "string"
            },
            "maxItems": 10,
            "title": "Heads Up",
            "type": "array"
          },
          "priorities": {
            "items": {
              "maxLength": 300,
              "type": "string"
            },
            "maxItems": 10,
            "title": "Priorities",
            "type": "array"
          }
        },
        "required": [
          "headline"
        ],
        "title": "DailySummary",
        "type": "object"
      },
      "DeviceInfo": {
        "description": "A paired phone. Carries no credential.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "last_seen_at": {
            "format": "date-time",
            "title": "Last Seen At",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "created_at",
          "last_seen_at"
        ],
        "title": "DeviceInfo",
        "type": "object"
      },
      "ErrorBody": {
        "description": "A plain error.",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "Event": {
        "description": "One normalised item (calendar event, assignment, email, weather). Immutable.",
        "properties": {
          "due": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Due"
          },
          "end": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "End"
          },
          "fetched_at": {
            "format": "date-time",
            "title": "Fetched At",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "enum": [
              "event",
              "assignment",
              "email",
              "weather"
            ],
            "title": "Kind",
            "type": "string"
          },
          "link": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Link"
          },
          "raw": {
            "additionalProperties": true,
            "title": "Raw",
            "type": "object"
          },
          "source": {
            "title": "Source",
            "type": "string"
          },
          "start": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start"
          },
          "status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "urgency": {
            "default": 0,
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Urgency",
            "type": "integer"
          },
          "user_id": {
            "default": "local",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "source",
          "kind",
          "title",
          "fetched_at"
        ],
        "title": "Event",
        "type": "object"
      },
      "PairRequest": {
        "additionalProperties": false,
        "description": "The one-time token shown on the Mac's pairing page, and a name for the phone.",
        "properties": {
          "device_name": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Device Name"
          },
          "pairing_token": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Pairing Token",
            "type": "string"
          }
        },
        "required": [
          "pairing_token"
        ],
        "title": "PairRequest",
        "type": "object"
      },
      "RefreshRequest": {
        "additionalProperties": false,
        "description": "The device's current refresh credential.",
        "properties": {
          "refresh_token": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Refresh Token",
            "type": "string"
          }
        },
        "required": [
          "refresh_token"
        ],
        "title": "RefreshRequest",
        "type": "object"
      },
      "SecretStatus": {
        "description": "What the settings API may reveal about a secret: whether it is set and its last 4 chars.\n\n`last4` is None for an unset secret and for any value shorter than 8 characters, where four\ncharacters would give away too much of the value.",
        "properties": {
          "last4": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last4"
          },
          "set": {
            "title": "Set",
            "type": "boolean"
          }
        },
        "required": [
          "set"
        ],
        "title": "SecretStatus",
        "type": "object"
      },
      "SourceSettings": {
        "description": "What the settings API may reveal about one source: per-key status plus its sync state.",
        "properties": {
          "keys": {
            "additionalProperties": {
              "$ref": "#/components/schemas/SecretStatus"
            },
            "title": "Keys",
            "type": "object"
          },
          "source": {
            "title": "Source",
            "type": "string"
          },
          "sync": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SyncState"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "source",
          "keys"
        ],
        "title": "SourceSettings",
        "type": "object"
      },
      "SummaryResult": {
        "description": "A summary and where it came from.\n\n`provider` is the provider's name for a fresh or cached summary, `\"stored\"` when an earlier\nday's summary stands in after a provider failure, and `\"template\"` for the built-in fallback.\n`cached` is true when the summary came from the store rather than from a provider call.",
        "properties": {
          "cached": {
            "title": "Cached",
            "type": "boolean"
          },
          "provider": {
            "title": "Provider",
            "type": "string"
          },
          "summary": {
            "$ref": "#/components/schemas/DailySummary"
          }
        },
        "required": [
          "summary",
          "provider",
          "cached"
        ],
        "title": "SummaryResult",
        "type": "object"
      },
      "SyncState": {
        "description": "The last sync result of one source.",
        "properties": {
          "at": {
            "format": "date-time",
            "title": "At",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "source": {
            "title": "Source",
            "type": "string"
          },
          "status": {
            "enum": [
              "syncing",
              "ok",
              "reconnect",
              "error"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "source",
          "status",
          "message",
          "at"
        ],
        "title": "SyncState",
        "type": "object"
      },
      "TokenResponse": {
        "description": "A device's credentials. The refresh credential is single use: store the new one.",
        "properties": {
          "access_expires_at": {
            "format": "date-time",
            "title": "Access Expires At",
            "type": "string"
          },
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "device_id": {
            "title": "Device Id",
            "type": "string"
          },
          "refresh_token": {
            "title": "Refresh Token",
            "type": "string"
          },
          "token_type": {
            "const": "bearer",
            "default": "bearer",
            "title": "Token Type",
            "type": "string"
          }
        },
        "required": [
          "device_id",
          "access_token",
          "access_expires_at",
          "refresh_token"
        ],
        "title": "TokenResponse",
        "type": "object"
      },
      "ValidationErrorBody": {
        "description": "Body of a 422 for a malformed request.",
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationIssue"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ValidationErrorBody",
        "type": "object"
      },
      "ValidationIssue": {
        "description": "One request field that failed validation; never echoes the submitted value.",
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Loc",
            "type": "array"
          },
          "msg": {
            "title": "Msg",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationIssue",
        "type": "object"
      }
    },
    "securitySchemes": {
      "DeviceToken": {
        "description": "A device access token from POST /v1/pair or /v1/pair/refresh. Required when the Host is the tailnet name; the Mac's own loopback web UI needs none.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Command Center",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/agenda/{period}": {
      "get": {
        "description": "Events in the day, Monday-based week or month containing `date`, in the user's timezone.",
        "operationId": "agenda_v1_agenda__period__get",
        "parameters": [
          {
            "in": "path",
            "name": "period",
            "required": true,
            "schema": {
              "enum": [
                "day",
                "week",
                "month"
              ],
              "title": "Period",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "date",
            "required": true,
            "schema": {
              "format": "date",
              "title": "Date",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Event"
                  },
                  "title": "Response Agenda V1 Agenda  Period  Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorBody"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        },
        "security": [
          {
            "DeviceToken": []
          }
        ],
        "summary": "Agenda for a day, week or month",
        "tags": [
          "agenda"
        ]
      }
    },
    "/v1/attention": {
      "get": {
        "description": "Urgent items (urgency 70+) and owed or overdue email, most urgent first.",
        "operationId": "attention_v1_attention_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Event"
                  },
                  "title": "Response Attention V1 Attention Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "DeviceToken": []
          }
        ],
        "summary": "Items needing attention",
        "tags": [
          "agenda"
        ]
      }
    },
    "/v1/devices": {
      "get": {
        "description": "Every paired phone, oldest first.",
        "operationId": "list_devices_v1_devices_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DeviceInfo"
                  },
                  "title": "Response List Devices V1 Devices Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "DeviceToken": []
          }
        ],
        "summary": "List paired devices",
        "tags": [
          "devices"
        ]
      }
    },
    "/v1/devices/{device_id}": {
      "delete": {
        "description": "Delete a device; its access and refresh tokens stop working at once.",
        "operationId": "revoke_device_v1_devices__device_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "device_id",
            "required": true,
            "schema": {
              "title": "Device Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorBody"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        },
        "security": [
          {
            "DeviceToken": []
          }
        ],
        "summary": "Revoke a paired device",
        "tags": [
          "devices"
        ]
      }
    },
    "/v1/events": {
      "get": {
        "description": "Events overlapping [from, to), scored now. Both bounds carry a timezone (use Z or %2B).",
        "operationId": "list_events_v1_events_get",
        "parameters": [
          {
            "in": "query",
            "name": "from",
            "required": true,
            "schema": {
              "format": "date-time",
              "title": "From",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "to",
            "required": true,
            "schema": {
              "format": "date-time",
              "title": "To",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Event"
                  },
                  "title": "Response List Events V1 Events Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorBody"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        },
        "security": [
          {
            "DeviceToken": []
          }
        ],
        "summary": "Events in a time window",
        "tags": [
          "agenda"
        ]
      }
    },
    "/v1/health": {
      "get": {
        "description": "Report that the server is up.",
        "operationId": "health_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health V1 Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness check",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/pair": {
      "post": {
        "description": "Trade the one-time pairing token (single use, 5 minutes) for an access and refresh token.",
        "operationId": "pair_v1_pair_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PairRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The token or credential is not valid"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Pairing is not available"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorBody"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Five failures in a row; wait Retry-After seconds",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "summary": "Exchange a pairing token for device credentials",
        "tags": [
          "pairing"
        ]
      }
    },
    "/v1/pair/refresh": {
      "post": {
        "description": "Trade the refresh credential for a new pair. Reusing a spent one revokes the device.",
        "operationId": "refresh_v1_pair_refresh_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The token or credential is not valid"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Pairing is not available"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorBody"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Five failures in a row; wait Retry-After seconds",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "summary": "Rotate a device's refresh credential",
        "tags": [
          "pairing"
        ]
      }
    },
    "/v1/settings": {
      "get": {
        "description": "Per source and per key: whether it is set and its last 4 characters; plus the sync state.",
        "operationId": "get_settings_v1_settings_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SourceSettings"
                  },
                  "title": "Response Get Settings V1 Settings Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "DeviceToken": []
          }
        ],
        "summary": "Status of every source",
        "tags": [
          "settings"
        ]
      }
    },
    "/v1/settings/{source}": {
      "delete": {
        "description": "Delete every stored key and every stored event of the source.",
        "operationId": "delete_settings_v1_settings__source__delete",
        "parameters": [
          {
            "in": "path",
            "name": "source",
            "required": true,
            "schema": {
              "title": "Source",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SourceSettings"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorBody"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        },
        "security": [
          {
            "DeviceToken": []
          }
        ],
        "summary": "Disconnect a source",
        "tags": [
          "settings"
        ]
      },
      "put": {
        "description": "Validate and store the credentials; the sync runs after the response (state \"syncing\").\n\nA credential-only integration (the Gemini key) has no sync: its result carries `sync` null.",
        "operationId": "put_settings_v1_settings__source__put",
        "parameters": [
          {
            "in": "path",
            "name": "source",
            "required": true,
