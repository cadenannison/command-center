{
  "name": "Command Center",
  "reference": "docs/design/README.md",
  "note": "Extracted from prototype.html :root blocks (dark, light, high contrast) and the prototype's priority table. spec.md wins on any disagreement.",
  "themes": {
    "dark": {
      "color": {
        "bgc": "#07090D",
        "text": "#F2F6FB",
        "text2": "#B4C0D0",
        "text3": "#8E9DB2",
        "ice": "#8FD3FF",
        "icergb": "143 211 255",
        "over": "#FF9AA6"
      },
      "glass": {
        "glass": "rgb(12 17 25/.46)",
        "bar": "rgb(10 14 20/.55)",
        "pop": "#101620",
        "edge": "rgb(255 255 255/.28)",
        "line": "rgb(255 255 255/.10)",
        "line2": "rgb(255 255 255/.18)",
        "chip": "rgb(255 255 255/.09)"
      },
      "source": {
        "cal": "167 139 250",
        "canvas": "255 122 138",
        "ls": "79 224 200",
        "gmail": "255 194 92",
        "wx": "124 199 255",
        "manual": "197 208 222"
      },
      "sourceInk": {
        "cal": "#BBA6FC",
        "canvas": "#FF9AA6",
        "ls": "#6FEAD6",
        "gmail": "#FFCB75",
        "wx": "#9AD6FF",
        "manual": "#C5D0DE"
      },
      "orbs": "radial-gradient(46vw 40vh at 8% 6%,rgb(60 130 255/.40),transparent 70%),radial-gradient(40vw 40vh at 94% 34%,rgb(40 200 190/.26),transparent 70%),radial-gradient(52vw 46vh at 50% 108%,rgb(120 90 255/.34),transparent 70%),linear-gradient(160deg,#0B1018,#07090D)"
    },
    "light": {
      "color": {
        "bgc": "#EEF3F9",
        "text": "#0E1622",
        "text2": "#3F4E62",
        "text3": "#566579",
        "ice": "#0A64B0",
        "icergb": "40 140 230",
        "over": "#B4233C"
      },
      "glass": {
        "glass": "rgb(255 255 255/.68)",
        "bar": "rgb(255 255 255/.6)",
        "pop": "#fff",
        "edge": "rgb(255 255 255/.95)",
        "line": "rgb(20 40 70/.12)",
        "line2": "rgb(20 40 70/.2)",
        "chip": "rgb(20 40 70/.07)"
      },
      "source": {
        "cal": "124 92 240",
        "canvas": "226 61 88",
        "ls": "13 160 138",
        "gmail": "224 150 20",
        "wx": "40 140 230",
        "manual": "110 126 148"
      },
      "sourceInk": {
        "cal": "#5B36C9",
        "canvas": "#B4233C",
        "ls": "#08705F",
        "gmail": "#8A5500",
        "wx": "#0A64B0",
        "manual": "#465569"
      },
      "orbs": "radial-gradient(46vw 40vh at 8% 6%,rgb(120 190 255/.60),transparent 70%),radial-gradient(40vw 40vh at 94% 34%,rgb(140 228 216/.50),transparent 70%),radial-gradient(52vw 46vh at 50% 108%,rgb(182 166 255/.50),transparent 70%),linear-gradient(160deg,#F8FAFD,#E9EFF7)"
    }
  },
  "highContrast": {
    "dark": {
      "glass": "#0D1118",
      "bar": "#0A0E14",
      "line": "rgb(255 255 255/.3)",
      "text3": "#B4C0D0"
    },
    "light": {
      "glass": "#fff",
      "bar": "#fff",
      "line": "rgb(20 40 70/.4)",
      "text3": "#3F4E62"
    }
  },
  "priority": {
    "colors": [
      "#34C17C",
      "#62C76C",
      "#93CD5E",
      "#BFCF52",
      "#E3C94A",
      "#F2B844",
      "#F69F42",
      "#F58545",
      "#F26A52",
      "#EF4B5C"
    ],
    "text": "#0A0D12",
    "numberAlwaysPrinted": true
  },
  "text": {
    "fontScale": {
      "default": 1,
      "spec": [
        0.85,
        1.5
      ]
    }
  },
  "shape": {
    "widgetRadius": "18px",
    "controlRadius": "10px",
    "chipRadius": "8px",
    "pillRadius": "11px",
    "calendarBlockRadius": "4px",
    "targetPx": 32,
    "calendarChipTargetPx": 24,
    "smallButtonTargetPx": 28
  },
  "glow": {
    "intensity": {
      "default": 1,
      "range": [
        0,
        1.6
      ]
    },
    "ringAlpha": 0.42,
    "innerBlurPx": 22,
    "innerAlpha": 0.36,
    "outerBlurPx": 64,
    "outerAlpha": 0.18
  },
  "density": {
    "comfortableRow": "3.1rem",
    "compactRow": "2.5rem",
    "gapPx": 14,
    "rowUnitPx": 40
  },
  "type": {
    "display": "Sora",
    "displayFile": "assets/sora.woff2",
    "ui": "-apple-system,BlinkMacSystemFont,\"SF Pro Text\",\"Segoe UI\",system-ui,sans-serif",
    "tabularFigures": true,
    "basePx": 14
  },
  "motion": {
    "fastMs": 140,
    "baseMs": 240,
    "checkOffMs": 420,
    "ease": "cubic-bezier(.2,.8,.2,1)"
  },
  "grid": {
    "columns": [
      12,
      8,
      4
    ],
    "zoomRange": [
      0.7,
      1.3
    ]
  }
}
